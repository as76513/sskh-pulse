# ---- Server ----
PORT=4000
NODE_ENV=development

# ---- JWT ----
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES=8h

# ---- AWS credentials ----
# Local dev: use the shubhshreekh-dev named profile (never static access keys).
# S3 presign calls (utils/s3.js) AND all Cognito calls hit real AWS even in
# local dev — DynamoDB is the only thing DYNAMO_ENDPOINT below redirects to a
# local container. In Lambda this is unset entirely; the SDK picks up the
# function's IAM execution role automatically (see infra/lambda.tf) — never
# set this in prod.
AWS_PROFILE=shubhshreekh-dev

# ---- Cognito (auth) ----
# Existing, shared user pool owned by another app — SSKH Pulse only has its
# own app client inside it (infra/cognito.tf). No local emulator; both local
# dev and Lambda hit this same real pool. Login screen collects a username
# (e.g. "john.doe"), never an email — it becomes "john.doe@<domain below>",
# the real identifier Cognito authenticates against (usernameToEmail in
# config/cognito.js). Real company emails already follow exactly this
# convention, so anyone already in the pool logs in with their existing
# password, no setup needed here.
COGNITO_USER_POOL_ID=ap-south-1_Gj6XcAi9D
COGNITO_CLIENT_ID=set-after-terraform-apply-see-cognito_client_id-output
COGNITO_EMAIL_DOMAIN=shubhshreeknowledgehub.com

# ---- DynamoDB ----
AWS_REGION=ap-south-1
DYNAMO_TABLE_PREFIX=sskh-pulse
# Point at DynamoDB Local for development (see infra/docker-compose.yml).
# Leave unset to hit real AWS DynamoDB (uses AWS_PROFILE above, or in Lambda, the IAM role).
DYNAMO_ENDPOINT=http://localhost:8000

# ---- AWS S3 (documents + payslips) ----
S3_BUCKET=sskh-pulse-files

# ---- Seeding ----
# Must satisfy the shared pool's password policy: 8+ chars, upper+lower+number+symbol.
SEED_PASSWORD=Admin@12345

# ---- CORS ----
CLIENT_ORIGIN=http://localhost:5173
