# ---- Server ----
PORT=4000
NODE_ENV=development

# ---- JWT ----
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES=8h

# ---- AWS credentials ----
# Local dev: use the shubhshreekh-dev named profile (never static access keys).
# S3 presign calls (utils/s3.js) hit real AWS even in local dev — DynamoDB is
# the only thing DYNAMO_ENDPOINT below redirects to a local container.
# In Lambda this is unset entirely; the SDK picks up the function's IAM
# execution role automatically (see infra/lambda.tf) — never set this in prod.
AWS_PROFILE=shubhshreekh-dev

# ---- DynamoDB ----
AWS_REGION=ap-south-1
DYNAMO_TABLE_PREFIX=sskh-pulse
# Point at DynamoDB Local for development (see infra/docker-compose.yml).
# Leave unset to hit real AWS DynamoDB (uses AWS_PROFILE above, or in Lambda, the IAM role).
DYNAMO_ENDPOINT=http://localhost:8000

# ---- AWS S3 (documents + payslips) ----
S3_BUCKET=sskh-pulse-files

# ---- Seeding ----
SEED_PASSWORD=admin123

# ---- CORS ----
CLIENT_ORIGIN=http://localhost:5173
